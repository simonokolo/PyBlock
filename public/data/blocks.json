      "outputs": [{ "name": "exec", "type": "flow" }, { "name": "result", "type": "float" }],
      "code": "A * B"
    },
    {
      "name": "Divide",
      "type": "Math",
      "blockImage": "../images/icons/block-icons/dividePyblock.png",
      "inputs": [{ "name": "exec", "type": "flow" }, { "name": "A"}, { "name": "B"}],
      "outputs": [{ "name": "exec", "type": "flow" }, { "name": "result", "type": "float" }],
      "code": "A / B"
    },
    {
      "name": "Modulus",
      "type": "Math",
      "blockImage": "../images/icons/block-icons/modPyblock.png",
      "inputs": [{ "name": "exec", "type": "flow" }, { "name": "A"}, { "name": "B"}],
