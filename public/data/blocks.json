{
  "blocks": [
    {
      "name": "Input",
      "type": "I/O",
      "blockImage": "../images/icons/block-icons/inputPyblock.png",
      "inputs": [{ "name": "exec", "type": "flow" }],
      "outputs": [
        { "name": "exec", "type": "flow" },
        { "name": "value", "type": "string" }
      ],
      "contents": [{ "name": "datatype", "type": "dropdown", "default": "string", "options": ["integer","string"] }],
      "code": "input()"
    },
    {
      "name": "Output",
      "type": "I/O",
      "blockImage": "../images/icons/block-icons/outputPyblock.png",
      "inputs": [
        { "name": "exec", "type": "flow" },
        { "name": "value", "type": "any" }
      ],
      "outputs": [{ "name": "exec", "type": "flow" }],
      "contents": [],
      "code": "print(value)"
    },

    {
      "name": "While",
      "type": "Loops",
      "blockImage": "../images/icons/block-icons/whilePyblock.png",
      "inputs": [
        { "name": "exec", "type": "flow" },
        { "name": "condition", "type": "boolean" }
      ],
      "outputs": [{ "name": "loopContent", "type": "flow" }, {"name": "loopComplete", "type": "flow"}],
      "contents": [],
      "code": "while condition:\n    pass"
    },
    {
      "name": "Loop X Times",
      "type": "Loops",
      "blockImage": "../images/icons/block-icons/loopPyblock.png",
      "inputs": [
        { "name": "exec", "type": "flow" },
        { "name": "count", "type": "integer" }
      ],
      "outputs": [{ "name": "loopContent", "type": "flow" }, { "name": "loopComplete", "type": "flow" }],
      "contents": [{ "name": "count", "type": "string", "default": "" }],
      "code": "for i in range(count):\n    pass"
    },
    {
      "name": "If",
      "type": "Loops",
      "blockImage": "../images/icons/block-icons/ifPyblock.png",
      "inputs": [
        { "name": "exec", "type": "flow" },
        { "name": "condition", "type": "boolean" }
      ],
      "outputs": [
        { "name": "true", "type": "flow" },
        { "name": "false", "type": "flow" }
      ],
      "contents": [],
      "code": "if condition:\n    pass\nelse:\n    pass"
    },

    {
      "name": "And",
      "type": "Logic",
      "blockImage": "../images/icons/block-icons/andPyblock.png",
      "inputs": [
        { "name": "A", "type": "boolean" },
        { "name": "B", "type": "boolean" }
      ],
      "outputs": [{ "name": "result", "type": "boolean" }],
      "contents": [],
      "code": "A and B"
    },
    {
      "name": "Not",
      "type": "Logic",
      "blockImage": "../images/icons/block-icons/notPyblock.png",
      "inputs": [{ "name": "A", "type": "boolean" }],
      "outputs": [{ "name": "result", "type": "boolean" }],
      "contents": [],
      "code": "not A"
    },
    {
      "name": "Or",
      "type": "Logic",
      "blockImage": "../images/icons/block-icons/orPyblock.png",
      "inputs": [
        { "name": "A", "type": "boolean" },
        { "name": "B", "type": "boolean" }
      ],
      "outputs": [{ "name": "result", "type": "boolean" }],
      "contents": [],
      "code": "A or B"
    },
    {
      "name": "Equals",
      "type": "Logic",
      "blockImage": "../images/icons/block-icons/equalsPyblock.png",
      "inputs": [
        { "name": "A", "type": "any" },
        { "name": "B", "type": "any" }
      ],
      "outputs": [{ "name": "result", "type": "boolean" }],
      "contents": [],
