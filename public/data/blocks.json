      "code": "A % B"
    },
    {
      "name": "Random",
      "type": "Math",
      "blockImage": "../images/icons/block-icons/randomPyblock.png",
      "inputs": [{ "name": "exec", "type": "flow" }],
      "outputs": [{ "name": "exec", "type": "flow" }, { "name": "value", "type": "float" }],
      "contents": [],
      "code": "random()"
    },

    {
      "name": "VarSet",
      "type": "Variables",
      "blockImage": "../images/icons/block-icons/varSetPyblock.png",
      "inputs": [
        { "name": "exec", "type": "flow" },
        { "name": "value", "type": "any" }
