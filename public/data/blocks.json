    },

    {
      "name": "Start",
      "type": "Terminator",
      "blockImage": "../images/icons/block-icons/startPyblock.png",
      "inputs": [],
      "outputs": [{ "name": "exec", "type": "flow" }],
      "contents": [],
      "code": ""
    }
  ]
