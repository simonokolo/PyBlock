      "outputs": [{ "name": "exec", "type": "flow" }],
      "contents": [{ "name": "variable", "type": "dropdown" }],
      "code": "variable = value"
    },
    {
      "name": "VarGet",
      "type": "Variables",
      "blockImage": "../images/icons/block-icons/varGetPyblock.png",
      "inputs": [],
      "outputs": [{ "name": "value", "type": "any" }],
      "contents": [{ "name": "variable", "type": "dropdown" }],
      "code": "variable"
    },
    {
      "name": "VarCreate",
      "type": "Variables",
      "blockImage": "../images/icons/block-icons/varCreatePyblock.png",
